<Window x:Class="DirectSunat.Presentación.Panel.WPF_Panel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DirectSunat.Presentación.Panel"
        mc:Ignorable="d"
        Title="DirectSUNAT - Panel Principal"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#6A1B9A">

    <Window.Resources>
        <!-- Estilo para los botones de pestañas del menú lateral -->
        <Style x:Key="MenuTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5E1688"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7B1FA2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Imagen vectorial para la foto de perfil del usuario -->
        <DrawingImage x:Key="FotoPerfilUsuarioImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- Fondo circular de la foto -->
                    <GeometryDrawing Brush="#7B1FA2">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Silueta de usuario (cabeza y hombros) -->
                    <GeometryDrawing Brush="#F3E5F5">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="20,14" RadiusX="6.5" RadiusY="6.5"/>
                                <PathGeometry Figures="M 8,34 C 8,25 13,23 20,23 C 27,23 32,25 32,34 Z"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Columna del menú lateral colapsable (inicia completamente expandido) -->
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <!-- Columna del resto del panel (morado) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- Área principal: Panel colapsable (con perfil abajo) y Contenido de pestañas -->
            <RowDefinition Height="*"/>
            <!-- Barra inferior de color negro por debajo del perfil de usuario que atraviesa toda la ventana -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- PANEL LATERAL COLAPSABLE (Morado Oscuro) -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#38006B"
                BorderBrush="#4A148C"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- Encabezado con nombre del proyecto DirectSUNAT y botón de colapsar -->
                <Grid DockPanel.Dock="Top" Height="70" Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Título del proyecto: DirectSUNAT (con SUNAT en itálica) -->
                    <StackPanel x:Name="BrandTitlePanel"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <TextBlock Text="Direct"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="SUNAT"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   Foreground="#E1BEE7"/>
                    </StackPanel>

                    <!-- Botón para colapsar / expandir el panel -->
                    <Button x:Name="BtnToggleSidebar"
                            Grid.Column="1"
                            Content="☰"
                            Width="38"
                            Height="38"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#4A148C"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Colapsar / Expandir menú"
                            Click="BtnToggleSidebar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#6A1B9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Separator DockPanel.Dock="Top"
                           Background="#4A148C"
                           Margin="12,0,12,15"
                           Height="1"/>

                <!-- PESTAÑAS DE NAVEGACIÓN (Dashboard, Usuarios, Configuración) -->
                <StackPanel DockPanel.Dock="Top">

                    <!-- Pestaña 1: Dashboard -->
                    <Button x:Name="BtnTabDashboard"
                            Style="{StaticResource MenuTabButtonStyle}"
                            Background="#6A1B9A"
                            Click="BtnTabDashboard_Click"
                            ToolTip="Dashboard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTabDashboard"
                                       Text="Dashboard"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pestaña 2: Usuarios -->
                    <Button x:Name="BtnTabUsuarios"
                            Style="{StaticResource MenuTabButtonStyle}"
                            Click="BtnTabUsuarios_Click"
                            ToolTip="Usuarios">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTabUsuarios"
                                       Text="Usuarios"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pestaña 3: Configuración -->
                    <Button x:Name="BtnTabConfiguracion"
                            Style="{StaticResource MenuTabButtonStyle}"
                            Click="BtnTabConfiguracion_Click"
                            ToolTip="Configuración">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTabConfiguracion"
                                       Text="Configuración"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- APARTADO DE PERFIL DE USUARIO (en la parte inferior del panel lateral, encima de la barra negra) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10">
                    <Separator Background="#4A148C"
                               Margin="4,0,4,10"
                               Height="1"/>

                    <Button x:Name="BtnPerfilUsuario"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="10,8"
                            HorizontalContentAlignment="Left"
                            ToolTip="Darius Figueroa (Superadmin)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="profileBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Efecto visual al acercar el mouse como si fuera a dar clic -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="profileBorder" Property="Background" Value="#5E1688"/>
                                        <Setter TargetName="profileBorder" Property="BorderBrush" Value="#9C27B0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="profileBorder" Property="Background" Value="#7B1FA2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Imagen para la foto de perfil -->
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    BorderBrush="#E1BEE7"
                                    BorderThickness="1.5"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Image Source="{StaticResource FotoPerfilUsuarioImage}"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <!-- Datos del usuario: Nombre y Rol -->
                            <StackPanel x:Name="PanelDatosUsuario"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock Text="Darius Figueroa"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="Superadmin"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="#B0B0B0"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- RESTO DEL PANEL (Morado) -->
        <Grid Grid.Row="0"
              Grid.Column="1"
              Background="#6A1B9A">
            <Grid.RowDefinitions>
                <!-- Barra superior -->
                <RowDefinition Height="70"/>
                <!-- Contenedor donde se carga WPF_Dashboard, WPF_Usuarios o WPF_Configuracion sin margin -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado de la sección actual -->
            <Border Grid.Row="0"
                    Background="#581582"
                    Padding="28,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSectionTitle"
                               Text="Dashboard"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Direct"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#E1BEE7"/>
                        <TextBlock Text="SUNAT"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   Foreground="White"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Contenedor dinámico sin Margin para que los módulos ocupen todo el espacio -->
            <ContentControl x:Name="ContenedorModulo"
                            Grid.Row="1"
                            Margin="0"/>
        </Grid>

        <!-- BARRA INFERIOR NEGRA POR DEBAJO DEL PERFIL DE USUARIO (atraviesa todo el panel) -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="#050505"
                BorderBrush="#222222"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">

                <!-- Botón de campanita de alertas a la derecha (como en la imagen de referencia) -->
                <Button x:Name="BtnAlertas"
                        DockPanel.Dock="Right"
                        Width="28"
                        Height="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Alertas">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="alertBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="alertBorder" Property="Background" Value="#262626"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="alertBorder" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <!-- Ícono vectorial de campanita blanca con punto morado de notificación -->
                    <Grid Width="18" Height="18">
                        <Path Fill="White"
                              Stretch="Uniform"
                              Width="15"
                              Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M12,22 C13.1,22 14,21.1 14,20 L10,20 C10,21.1 10.9,22 12,22 Z M18,16 L18,11 C18,7.93 16.36,5.36 13.5,4.68 L13.5,4 C13.5,3.17 12.83,2.5 12,2.5 C11.17,2.5 10.5,3.17 10.5,4 L10.5,4.68 C7.63,5.36 6,7.92 6,11 L6,16 L4,18 L4,19 L20,19 L20,18 L18,16 Z"/>
                        <!-- Punto morado indicador de alerta -->
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="#9575CD"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,1,1,0"/>
                    </Grid>
                </Button>

            </DockPanel>
        </Border>

    </Grid>
</Window>
