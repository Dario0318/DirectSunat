<UserControl x:Class="DirectSunat.Presentación.Módulos.WPF_Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DirectSunat.Presentación.Módulos"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Margin="0">
    <Grid Background="#7B1FA2" Margin="0">
        <StackPanel Margin="24">

            <!-- Encabezado: Título a la izquierda y botón "Actualizar" al extremo derecho -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Resumen de Operaciones (Dashboard)"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnActualizar"
                        Grid.Column="1"
                        Content="Actualizar"
                        Width="130"
                        Height="36"
                        Background="#4A148C"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderBrush="#E1BEE7"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#5E1688"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#38006B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Filtros para personalizar la búsqueda (reemplaza la descripción) -->
            <Border Background="#6A1B9A"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,20">
                <UniformGrid Columns="3">

                    <!-- Combo 1: Corporación -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Corporación"
                                   Foreground="#E1BEE7"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboCorporacion"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Corporacion A"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Combo 2: Empresa -->
                    <StackPanel Margin="5,0,5,0">
                        <TextBlock Text="Empresa"
                                   Foreground="#E1BEE7"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboEmpresa"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Empresa A"/>
                            <ComboBoxItem Content="Empresa B"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Combo 3: Tipo Documento -->
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Tipo Documento"
                                   Foreground="#E1BEE7"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboTipoDocumento"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Boleta"/>
                            <ComboBoxItem Content="Nota de Credito"/>
                        </ComboBox>
                    </StackPanel>

                </UniformGrid>
            </Border>

            <!-- Tarjetas de resumen -->
            <UniformGrid Columns="3">
                <Border Background="#6A1B9A" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Documentos Enviados" Foreground="#E1BEE7" FontSize="13"/>
                        <TextBlock Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#6A1B9A" CornerRadius="10" Padding="18" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Aceptados por SUNAT" Foreground="#E1BEE7" FontSize="13"/>
                        <TextBlock Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#6A1B9A" CornerRadius="10" Padding="18" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Pendientes / Observados" Foreground="#E1BEE7" FontSize="13"/>
                        <TextBlock Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </Grid>
</UserControl>
