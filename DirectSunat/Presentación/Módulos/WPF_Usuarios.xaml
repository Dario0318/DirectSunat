<UserControl x:Class="DirectSunat.Presentación.Módulos.WPF_Usuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DirectSunat.Presentación.Módulos"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Margin="0">
    <Grid Background="#7B1FA2" Margin="0">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Botón Crear Usuario -->
                <RowDefinition Height="Auto"/>
                <!-- Línea separadora -->
                <RowDefinition Height="Auto"/>
                <!-- Tabla de usuarios -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Botón rectangular con borde llamado "Crear Usuario" -->
            <Button x:Name="BtnCrearUsuario"
                    Grid.Row="0"
                    Content="Crear Usuario"
                    Width="150"
                    Height="38"
                    HorizontalAlignment="Left"
                    Background="#4A148C"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderBrush="White"
                    BorderThickness="1.5"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#5E1688"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#38006B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Línea separadora -->
            <Separator Grid.Row="1"
                       Background="#D1C4E9"
                       Height="1"
                       Margin="0,16,0,16"/>

            <!-- Tabla de Usuarios (Id, Nombres, Apellidos, Rol, Estado) -->
            <DataGrid x:Name="dgvUsuarios"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0"
                      RowHeight="36"
                      ColumnHeaderHeight="40"
                      Background="White"
                      Foreground="#212121"
                      BorderBrush="#4A148C"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                    <DataGridTextColumn Header="Nombres" Binding="{Binding Nombres}" Width="*"/>
                    <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*"/>
                    <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="150"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
