<Window x:Name="WPF_Toaster1" x:Class="DirectSunat.Presentación.R.WPF_Toaster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DirectSunat.Presentación.R"
        mc:Ignorable="d"
        Title="WPF_Toaster" Height="60" Width="286" WindowStyle="None" Loaded="WPF_Toaster1_Loaded">
    <Grid>
        <Label x:Name="lblIndicadorColor" Background="Red" Margin="0,0,270,0"/>
        <Label x:Name="lblTextoIndicador" Content="Mensaje en pantalla" Margin="21,0,57,0" FontSize="16" VerticalAlignment="Center"/>
        <Button x:Name="btnCerrarToaster" Margin="240,16,16,15" RenderTransformOrigin="0.491,0.124" Click="btnCerrarToaster_Click" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="/Presentación/R/icons8-cerrar-ventana-96.png"/>
            </Button.Background>
        </Button>
    </Grid>
</Window>
